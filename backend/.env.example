# Gemini API Key for LLM features (embeddings, chat, data extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional redirect URI override (defaults to backend host callback url if unset)
GOOGLE_REDIRECT_URI=

# Database configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Security secrets (should be secure random hex strings in production)
JWT_SECRET=generate_with_python_secrets_token_hex_32
SESSION_SECRET=generate_with_python_secrets_token_hex_32

# CORS & Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment (development or production)
ENV=development
